<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    8-5: 설정 실습

    학습 포인트:
    1. TypeAlias: application.properties의 type-aliases-package 설정으로
       전체 경로 대신 클래스명만 사용 가능 (Book vs com.ssafy.ws.model.dto.Book)

    2. ResultMap: DB 컬럼명과 Java 필드명이 다를 때 매핑

    3. 대안: mybatis.configuration.map-underscore-to-camel-case=true
-->
<mapper namespace="com.ssafy.ws.model.dao.BookDao">

    <!-- TODO: ResultMap을 정의하세요 -->
	<resultMap id="BookResultMap" type="Book">
		<id property="isbn" column="isbn"/>
		<result property="title" column="title"/>
		<result property="author" column="author"/>
		<result property="price" column="price"/>
	</resultMap>

    <!-- TODO: resultMap을 사용하는 SELECT로 변경하세요 -->
    <select id="selectAll" resultType="Book">
        SELECT isbn, title, author, price
        FROM book
    </select>

    <select id="select" parameterType="String" resultType="Book">
        SELECT isbn, title, author, price
        FROM book
        WHERE isbn = #{isbn}
    </select>

    <!-- INSERT -->
    <insert id="insert" parameterType="Book">
        INSERT INTO book (isbn, title, author, price)
        VALUES (#{isbn}, #{title}, #{author}, #{price})
    </insert>

    <!-- UPDATE -->
    <update id="update" parameterType="Book">
        UPDATE book
        SET title = #{title},
            author = #{author},
            price = #{price}
        WHERE isbn = #{isbn}
    </update>

    <!-- DELETE -->
    <delete id="delete" parameterType="String">
        DELETE FROM book
        WHERE isbn = #{isbn}
    </delete>

</mapper>
