<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>도서 상세</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; }
        h1 { color: #333; }
        .detail-container { background-color: #f9f9f9; padding: 20px; border-radius: 8px; max-width: 500px; margin-top: 20px; }
        .detail-row { margin-bottom: 10px; }
        .detail-label { font-weight: bold; display: inline-block; width: 80px; }
        .btn { display: inline-block; padding: 8px 16px; color: white; text-decoration: none; border-radius: 4px; margin-top: 15px; margin-right: 10px; }
        .btn-edit { background-color: #3c90e2; }
        .btn-edit:hover { background-color: #1C64D0; }
        .btn-list { background-color: #888; }
        .btn-list:hover { background-color: #666; }
    </style>
</head>
<body>
    <h1>도서 상세</h1>

    <div class="detail-container">
        <%-- TODO: 도서 상세 정보를 출력하세요 --%>
        <%-- 힌트: ${book.isbn}, ${book.title}, ${book.author}, ${book.price} --%>
        <div class="detail-row">
            <span class="detail-label">ISBN</span>
            <span>${book.isbn}</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">제목</span>
            <span>${book.title}</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">저자</span>
            <span>${book.author}</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">가격</span>
            <span>${book.price}원</span>
        </div>
    </div>

    <%-- TODO: 수정 버튼과 목록으로 링크를 추가하세요 --%>
    <%-- 힌트: href="${pageContext.request.contextPath}/book/edit?isbn=${book.isbn}" --%>
	<a href="${pageContext.request.contextPath}/book/edit?isbn=${book.isbn}"></a>
    <a href="${pageContext.request.contextPath}/book/list" class="btn btn-list">목록으로</a>
</body>
</html>
