<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>도서 상세</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; }
        h1 { color: #333; }
        .detail-container { background-color: #f9f9f9; padding: 20px; border-radius: 8px; max-width: 500px; margin-top: 20px; }
        .detail-row { margin-bottom: 10px; }
        .detail-label { font-weight: bold; display: inline-block; width: 80px; }
        .btn { display: inline-block; padding: 8px 16px; color: white; text-decoration: none; border-radius: 4px; margin-top: 15px; margin-right: 10px; border: none; cursor: pointer; font-size: 14px; }
        .btn-edit { background-color: #3c90e2; }
        .btn-edit:hover { background-color: #1C64D0; }
        .btn-delete { background-color: #f44336; }
        .btn-delete:hover { background-color: #d32f2f; }
        .btn-list { background-color: #888; }
        .btn-list:hover { background-color: #666; }
    </style>
</head>
<body>
    <h1>도서 상세</h1>

    <div class="detail-container">
        <div class="detail-row">
            <span class="detail-label">ISBN</span>
            <span>${book.isbn}</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">제목</span>
            <span>${book.title}</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">저자</span>
            <span>${book.author}</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">가격</span>
            <span>${book.price}원</span>
        </div>
    </div>

    <a href="${pageContext.request.contextPath}/book/edit?isbn=${book.isbn}" class="btn btn-edit">수정</a>
    <%-- TODO: 삭제 버튼을 추가하세요 --%>
    <%-- 힌트: form 태그로 POST 방식 요청, action="/book/delete", hidden input으로 isbn 전달 --%>
    <%-- confirm 다이얼로그로 삭제 확인: onclick="return confirm('정말 삭제하시겠습니까?');" --%>
	<form action="/book/delete" method="post" style="display: inline;">
	    <input type="hidden" name="isbn" value="${book.isbn}">
	    <button onclick="return confirm('정말 삭제하시겠습니까?');">삭제</button>
	</form>
    <a href="${pageContext.request.contextPath}/book/list" class="btn btn-list">목록으로</a>
</body>
</html>
