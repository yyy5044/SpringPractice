spring.application.name=framework_back_ws_08_5

# DataSource 설정
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.url=jdbc:mysql://localhost:3306/ssafydb?serverTimezone=UTC
spring.datasource.username=ssafy
spring.datasource.password=ssafy

# MyBatis 설정
mybatis.mapper-locations=classpath:mappers/*.xml

# TODO: TypeAlias 설정을 추가하세요
mybatis.type-aliases-package=com.ssafy.ws.model.dto
# TODO: (선택) 카멜케이스 자동 매핑 설정을 추가하세요

# TODO: SQL 로깅 설정을 추가하세요

# JSP 설정
spring.mvc.view.prefix=/WEB-INF/views/
spring.mvc.view.suffix=.jsp

# Schema 자동 실행
spring.sql.init.mode=always
spring.sql.init.schema-locations=classpath:schema.sql
