<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.hw.model.dao.MovieDao">

    <!-- 전체 영화 목록 조회 -->
    <select id="selectAll" resultType="Movie">
        SELECT id, title, director, genre, running_time,
               release_year, rating, created_at, updated_at
        FROM movie
        ORDER BY created_at DESC
    </select>

    <!-- ID로 영화 조회 -->
    <select id="findById" parameterType="int" resultType="Movie">
        SELECT id, title, director, genre, running_time,
               release_year, rating, created_at, updated_at
        FROM movie
        WHERE id = #{id}
    </select>

    <!--
        TODO 1: 제목으로 검색 (<if> 태그 사용)

        요구사항:
        - title이 null이거나 빈 문자열이면 전체 조회
        - title이 있으면 LIKE 검색 (부분 일치)
        - WHERE 1=1 패턴 사용
    -->
    <select id="searchByTitle" parameterType="string" resultType="Movie">
        <!-- TODO: 구현하세요 -->
        SELECT id, title, director, genre, running_time,
               release_year, rating, created_at, updated_at
        FROM movie
        WHERE 1=1
        <!-- <if> 태그로 title 조건 추가 -->
		<if test="title!=null and title!=''">
			and title like concat('%', #{title}, '%')
		</if>
        ORDER BY title
    </select>

    <!--
        TODO 2: 감독으로 검색 (<if> 태그 사용)

        요구사항:
        - director가 null이거나 빈 문자열이면 전체 조회
        - director가 있으면 LIKE 검색 (부분 일치)
    -->
    <select id="searchByDirector" parameterType="string" resultType="Movie">
        <!-- TODO: 구현하세요 -->
        SELECT id, title, director, genre, running_time,
               release_year, rating, created_at, updated_at
        FROM movie
        WHERE 1=1
        <!-- <if> 태그로 director 조건 추가 -->
		<if test="director!=null and director!=''">
			and director like concat('%', #{director}, '%')
		</if>
        ORDER BY director, title
    </select>

    <!--
        TODO 3: 타입별 검색 (<choose>, <when>, <otherwise> 태그 사용)

        요구사항:
        - searchType = "title": 제목에서 검색
        - searchType = "director": 감독에서 검색
        - searchType = "genre": 장르에서 검색 (정확히 일치)
        - otherwise: 제목 또는 감독에서 검색
    -->
    <select id="searchByType" resultType="Movie">
        <!-- TODO: 구현하세요 -->
        SELECT id, title, director, genre, running_time,
               release_year, rating, created_at, updated_at
        FROM movie
        WHERE 1=1
        <if test="keyword != null and keyword != ''">
            <!-- <choose> 태그로 searchType에 따른 분기 구현 -->
			<choose>
				<when test="searchType=='title'">
					and title like concat('%', #{keyword}, '%')
				</when>
				<when test="searchType=='director'">
					and director like concat('%', #{keyword}, '%')
				</when>
				<when test="searchType=='genre'">
					and genre=#{keyword}
				</when>
				<otherwise>
				    and (title like concat('%', #{keyword}, '%')
				     or director like concat('%', #{keyword}, '%'))
				</otherwise>
			</choose>
        </if>
        ORDER BY title
    </select>

    <!--
        TODO 4: 정렬 옵션 포함 검색

        요구사항:
        - keyword가 있으면 제목 또는 감독에서 검색
        - orderBy로 정렬 기준 선택 (title, director, rating, running_time, releaseYear)
          - releaseYear는 컬럼명이 release_year임에 주의
        - orderDir이 "desc"면 내림차순
    -->
    <select id="searchWithSort" resultType="Movie">
        <!-- TODO: 구현하세요 -->
        SELECT id, title, director, genre, running_time,
               release_year, rating, created_at, updated_at
        FROM movie
        WHERE 1=1
        <!-- keyword 검색 조건 -->
		<if test="keyword!=null and keyword!=''">
		    and (title like concat('%', #{keyword}, '%')
		     or director like concat('%', #{keyword}, '%'))
		</if>
        ORDER BY
        <!-- 정렬 기준 (choose) -->
        <choose>
        	<when test="orderBy=='title'">
        		title
        	</when>
        	<when test="orderBy=='director'">
        		director
        	</when>
        	<when test="orderBy=='rating'">
        		rating
        	</when>
        	<when test="orderBy=='running_time'">
        		running_time
        	</when>
        	<when test="orderBy=='releaseYear'">
        		release_year
        	</when>
        	<otherwise>
        		created_at
        	</otherwise>
        </choose>
        <!-- 정렬 방향 (if) -->
		<if test="orderDir=='desc'">
			DESC
		</if>
    </select>

</mapper>
